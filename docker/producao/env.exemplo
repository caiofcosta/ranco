# Modelo do .env da pasta ranco-producao (copiar para .env e trocar os "troque").
# Senhas e chaves só com letras e números: o Docker Compose lê este arquivo e interpreta "$".
# Gerar valores: openssl rand -hex 24. APP_KEY: ver "Produção" em docs/publicacao.md.

APP_NAME="RANÇO"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://seu-dominio.exemplo

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mariadb
DB_HOST=db
DB_PORT=3306
DB_DATABASE=ranco
DB_USERNAME=ranco
DB_PASSWORD=troque
DB_ROOT_PASSWORD=troque

SESSION_DRIVER=database
SESSION_LIFETIME=1440
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# Laravel -> Reverb pela rede interna do Docker; o navegador usa o endereço público (VITE_*).
REVERB_APP_ID=troque
REVERB_APP_KEY=troque
REVERB_APP_SECRET=troque
REVERB_HOST=reverb
REVERB_PORT=8081
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8081
REVERB_ALLOWED_ORIGINS=seu-dominio.exemplo
VITE_REVERB_HOST=seu-dominio.exemplo
VITE_REVERB_PORT=443
VITE_REVERB_SCHEME=https

# IP fixo do container do túnel (docker-compose.producao.yml).
TRUSTED_PROXIES=172.30.50.10

MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=smtp.seu-provedor.exemplo
MAIL_PORT=465
MAIL_USERNAME=nao-responda@seu-dominio.exemplo
MAIL_PASSWORD=troque
MAIL_FROM_ADDRESS="nao-responda@seu-dominio.exemplo"
MAIL_FROM_NAME="RANÇO"

RANCO_ADMINISTRADORES=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://seu-dominio.exemplo/auth/google/callback

# Token do túnel nomeado (Cloudflare Zero Trust > Networks > Tunnels). Vazio: o túnel não sobe.
CLOUDFLARE_TUNNEL_TOKEN=
